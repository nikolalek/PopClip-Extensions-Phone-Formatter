{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["@popclip/types"]
  },
  "include": [
    "phone-formatter.popclipext/Config.js",
  ],
  "exclude": [
    "phone-formatter.popclipext/libphonenumber-max.js"
  ]
}
